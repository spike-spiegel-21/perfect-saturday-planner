# OpenRouter key for the app (create one at https://openrouter.ai/settings/keys with a credit limit)
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-5
# reasoning effort for the planner loop: low | medium | high
PLANNER_EFFORT=low
DB_PATH=planner.db
# comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# lets the UI's "Test failure modes" menu simulate outages
ALLOW_SIMULATION=true
RATE_USER_PER_DAY=8
RATE_IP_PER_DAY=20
RATE_GLOBAL_PER_DAY=150
# fake latency for the mock tools, so the live trace looks like real API calls
MOCK_LATENCY_MS=250

# --- live data (optional; each falls back to the sample city data when unset or failing) ---
# Google Places API (New) key: restaurants and activities with real hours, ratings, prices, veg/accessibility flags
GOOGLE_MAPS_API_KEY=
PLACES_CACHE_HOURS=12
# Swiggy Scenes live events. Personal OAuth token, valid 5 days, no refresh:
#   uv run python -m app.sources.swiggy_login   (phone + OTP in the browser; writes the two lines below)
SWIGGY_SCENES_TOKEN=
SWIGGY_SCENES_TOKEN_EXPIRES=
SWIGGY_SCENES_URL=https://mcp.swiggy.com/scenes
EVENTS_CACHE_HOURS=3
LIVE_EVENTS_MAX=12
