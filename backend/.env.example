# OpenRouter key for the app (create one at https://openrouter.ai/settings/keys with a credit limit)
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-5
# reasoning effort for the planner loop: low | medium | high
PLANNER_EFFORT=low
DB_PATH=planner.db
# comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# lets the UI's "Test failure modes" menu simulate outages
ALLOW_SIMULATION=true
RATE_USER_PER_DAY=8
RATE_IP_PER_DAY=20
RATE_GLOBAL_PER_DAY=150
# fake latency for the mock tools, so the live trace looks like real API calls
MOCK_LATENCY_MS=250
